# Opcional: TURN para que el online funcione con datos móviles (NAT estricto).
# Sin esto anda en el mismo Wi-Fi y en la mayoría de las conexiones hogareñas.
# VITE_TURN_URL=turn:tu-servidor-turn:3478,turns:tu-servidor-turn:443
# VITE_TURN_USER=usuario
# VITE_TURN_PASS=clave

# Opcional: servidor de salas propio (por defecto se usa el público y gratuito de PeerJS).
# VITE_PEER_HOST=tu-peerserver.onrender.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true
